#!/usr/bin/env bash

set -eo pipefail

export DOTFILES_DIR="${DOTFILES_DIR:-$(cd -- "$(dirname "$0")/.." &>/dev/null && pwd -P)}"

source "$DOTFILES_DIR/scripts/lib/cli.sh"
source "$DOTFILES_DIR/scripts/lib/prompt.sh"
source "$DOTFILES_DIR/scripts/lib/clipboard.sh"

default_excludes=(.git .local logs tmp node_modules __pycache__ .DS_Store)

usage() {
  cat <<-EOF
Usage: rcp

Copy a file or directory between two remote servers through local machine, for
servers that cannot connect to each other directly. Data is streamed by
'ssh src | ssh dest', nothing is stored locally.

Steps:
  1. On source server, run 'rinfo <file|dir>' (use '-F' for files over 10M)
  2. On local, run 'rcp', which reads the source from clipboard
  3. On destination server, run 'rinfo <dir|file>', then press Enter in rcp

Destination semantics are the same as rput:
  * A directory with the same name as source: merge contents into it
  * Any other directory: put source inside it
  * A file (source must be a file): overwrite it

Options:
  [--no-exclude] Do not exclude common directories (${default_excludes[*]})
EOF
  exit 1
}

while [ $# -gt 0 ]; do
  case "$1" in
    --no-exclude)
      no_exclude=1
      ;;
    *)
      usage
      ;;
  esac
  shift
done

# Parse clipboard content generated by rinfo, i.e. "[-r ]user@ip:/path".
#
# @params:
#   $1: variable prefix, `<prefix>_host`, `<prefix>_path` and `<prefix>_is_dir`
#       will be defined
read_remote_path() {
  local content
  get_clipboard content
  if [[ ! "$content" =~ ^(-r\ )?(.+@[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+):(.+)$ ]]; then
    echo "Clipboard content doesn't match the format: [-r ]user@ip:/path/to/file"
    echo "Got: $content"
    exit 1
  fi
  printf -v "${1}_is_dir" '%s' "${BASH_REMATCH[1]:+1}"
  printf -v "${1}_host" '%s' "${BASH_REMATCH[2]}"
  printf -v "${1}_path" '%s' "${BASH_REMATCH[3]%/}"
  printf -v "${1}_raw" '%s' "$content"
}

q() {
  printf '%q' "$1"
}

read_remote_path src
echo "Source: $src_host:$src_path$([ -n "$src_is_dir" ] && echo ' (directory)')"

while true; do
  read -r -p "Run 'rinfo <dir|file>' on destination server, then press Enter..." </dev/tty
  read_remote_path dest
  if [ "$dest_raw" = "$src_raw" ]; then
    echo "Clipboard still holds the source, please copy the destination first."
    continue
  fi
  break
done
echo "Destination: $dest_host:$dest_path$([ -n "$dest_is_dir" ] && echo ' (directory)')"

src_name="$(basename "$src_path")"

if [ -n "$dest_is_dir" ]; then
  if [ "$src_name" = "$(basename "$dest_path")" ]; then
    target="$dest_path"
  else
    target="$dest_path/$src_name"
  fi
else
  [ -n "$src_is_dir" ] && abort "Cannot copy a directory to a file: $dest_path"
  target="$dest_path"
fi

if [ -n "$src_is_dir" ]; then
  # Archive the contents ('.') rather than the directory itself, so excludes
  # never match the top directory (e.g. a source dir named 'tmp').
  excludes=""
  if [ -z "$no_exclude" ]; then
    for pattern in "${default_excludes[@]}"; do
      excludes+=" --exclude=$(q "$pattern")"
    done
  fi
  src_cmd="tar -C $(q "$src_path")$excludes -czf - ."
  dest_cmd="mkdir -p $(q "$target") && tar -C $(q "$target") -xzf -"
elif [ -n "$dest_is_dir" ]; then
  src_cmd="tar -C $(q "$(dirname "$src_path")") -czf - $(q "$src_name")"
  dest_cmd="tar -C $(q "$dest_path") -xzf -"
else
  src_cmd="gzip -c $(q "$src_path")"
  dest_cmd="gzip -dc > $(q "$target")"
fi

# Ask before overwriting a file. Merging into an existing directory is expected.
if [ -z "$src_is_dir" ] && ssh -n "$dest_host" "test -e $(q "$target")"; then
  if [ "$(yesno "$dest_host:$target already exists. Do you want to overwrite it? (y/N)" "no")" != "yes" ]; then
    exit 1
  fi
fi

echo "ssh $src_host '$src_cmd' | ssh $dest_host '$dest_cmd'"
if command -v pv &>/dev/null; then
  ssh -n "$src_host" "$src_cmd" | pv | ssh "$dest_host" "$dest_cmd"
else
  ssh -n "$src_host" "$src_cmd" | ssh "$dest_host" "$dest_cmd"
fi
echo "Done."
