#!/usr/bin/env bash

set -eo pipefail

export DOTFILES_DIR="${DOTFILES_DIR:-$(cd -- "$(dirname "$0")/.." &>/dev/null && pwd -P)}"
ps_dir="$DOTFILES_DIR/scripts/ps"

source "$DOTFILES_DIR/scripts/lib/cli.sh"

usage() {
  cat <<-EOF
Wrapper for ps utility.

Subcommands:
  fzf      - select a process by fzf and output its details
  tree     - show the process tree of a pid with full command lines
EOF
  exit 1
}

case "$1" in
  fzf | tree)
    source "$ps_dir/$1.sh"
    run "$@"
    ;;
  -h)
    usage
    ;;
  -)
    shift
    ps "$@"
    ;;
  *)
    ps "$@"
    ;;
esac
