#!/usr/bin/env bash

set -e

export DOTFILES_DIR="${DOTFILES_DIR:-$(cd -- "$(dirname "$0")/.." &>/dev/null && pwd -P)}"
image_utils_dir="$DOTFILES_DIR/scripts/image-utils"

source "$DOTFILES_DIR/scripts/lib/cli.sh"

usage() {
  cat <<-EOF
Utilities to process images.

Subcommands:
  tv, to_video - combine a directory of images into a video
  e,  editor   - open an image editor (GIMP)
  g,  gallery  - view all images in a directory as a thumbnail grid
  fotokilof    - GUI for ImageMagick and Wand or Pillow
EOF
  exit 1
}

case "$1" in
  fotokilof)
    # https://github.com/TeaM-TL/FotoKilof
    # pip install fotokilof
    fotokilof
    ;;
  tv | to_video | e | editor | g | gallery)
    case "$1" in
      tv)
        name="to_video"
        ;;
      e)
        name="editor"
        ;;
      g)
        name="gallery"
        ;;
      *)
        name="$1"
        ;;
    esac
    source "$image_utils_dir/$name.sh"
    run "$@"
    ;;
  *)
    usage
    ;;
esac
