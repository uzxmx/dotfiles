#!/usr/bin/env bash
#
# Install yazi (https://github.com/sxyazi/yazi), a terminal file manager.
#
# The config is linked if `bin/rcup` hasn't done it yet, then plugins listed in
# package.toml are installed.

set -eo pipefail

export DOTFILES_DIR="${DOTFILES_DIR:-$(cd -- "$(dirname "$0")/../.." &>/dev/null && pwd -P)}"
export DOTFILES_TARGET_DIR="${DOTFILES_TARGET_DIR:-$HOME}"

source "$DOTFILES_DIR/scripts/lib/install.sh"

# `ya` installs plugins into $XDG_CONFIG_HOME/yazi, so point it at the config
# linked by rcup (which differs from ~/.config when DOTFILES_TARGET_DIR is set).
export XDG_CONFIG_HOME="$DOTFILES_TARGET_DIR/.config"

# Link any yazi config files that `bin/rcup` hasn't linked yet, so this script
# works even when run before rcup. Hooks are skipped to only touch yazi files.
link_config() {
  local file name missing=()
  for file in "$DOTFILES_DIR"/config/yazi/*; do
    name="$(basename "$file")"
    [ -L "$XDG_CONFIG_HOME/yazi/$name" ] || missing+=("config/yazi/$name")
  done
  [ ${#missing[@]} -eq 0 ] && return

  info "Linking yazi config: ${missing[*]}"
  (
    cd "$DOTFILES_DIR"
    PATH="$DOTFILES_DIR/scripts/rcm/bin:$PATH" \
      rcup -K -T "$DOTFILES_TARGET_DIR" -d "$DOTFILES_DIR" "${missing[@]}"
  )
}

install_plugins() {
  link_config
  ya pkg install
}

if check_command yazi &> /dev/null; then
  install_plugins
  exit
fi

if is_mac; then
  # ffmpeg: video thumbnails, poppler: PDF preview, imagemagick: HEIC/SVG etc.,
  # sevenzip: archive preview.
  brew_install yazi ffmpeg poppler imagemagick sevenzip
  # Icons need a Nerd Font, see scripts/misc/setup_iterm2.sh for iTerm2.
  "$DOTFILES_DIR/scripts/install/nerd_font"
  install_plugins
  exit
fi

version="26.8.15"
if is_arm64; then
  platform="aarch64-unknown-linux-musl"
else
  platform="x86_64-unknown-linux-musl"
fi

install_fn() {
  local dir="$1/yazi-$platform"
  mkdir -p "$DOTFILES_TARGET_DIR/bin"
  mv "$dir/yazi" "$dir/ya" "$DOTFILES_TARGET_DIR/bin"
}

download_and_install "https://github.com/sxyazi/yazi/releases/download/v$version/yazi-$platform.zip" install_fn
install_plugins
